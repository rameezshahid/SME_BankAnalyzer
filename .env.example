# Copy to .env and adjust. Everything here is optional.

# Local LLM enrichment via Ollama: true | false | auto (use it if reachable)
OLLAMA_ENABLED=auto
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:30b
OLLAMA_TIMEOUT=300
# Max LLM classification calls per statement
OLLAMA_MAX_CALLS=10

# Account holder name(s), comma-separated, so own-account transfers aren't listed as counterparties
OWN_ACCOUNT_NAMES=
